# Monte Moria — Docker environment variables
# Copy from .env.example and adjust for Docker network Docker DNS resolves services by container name

# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/quadro_do_mane?schema=public"
POSTGRES_DB=quadro_do_mane
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── API ─────────────────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=production

# ─── JWT ─────────────────────────────────────────────────────────────────
# These should be set via secret management in production
JWT_SECRET="7d4b43a1e8ded0189dce5a5ec2358ffc071a71d5bf161e5bff0ceabd70d1e013"
JWT_REFRESH_SECRET="43f68c2826810aa0db62695fc7fc9985c4b63ce271880a022abc359ef79ff959"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Encryption (AES-256-GCM) ─────────────────────────────────────────────
ENCRYPTION_KEY="5a570283a272480bef75820f65d71a31c1ec2f0f548670e0c5ea8213da3be15c"

# ─── Frontend ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.montemoria.com/api
API_BACKEND_URL=http://api:3001

# ─── S3 / Object Storage ─────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=monte-moria

# ─── Cookie / CORS ───────────────────────────────────────────────────────
COOKIE_DOMAIN=montemoria.com
COOKIE_SECURE=true
CORS_ORIGINS=https://montemoria.com,https://api.montemoria.com

# ─── AI provider ──────────────────────────────────────────────────────────
# AI_ENABLED gates only the API-key fallback. Global ChatGPT OAuth remains
# available when this is false. Keep the key in secret management.
AI_ENABLED=false
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ─── ChatGPT plan OAuth ────────────────────────────────────────────────────
# Keep tokens and keys in the deployment secret manager, not in this file.
CHATGPT_OAUTH_AGENT_NAME="Monte Moria"
CHATGPT_OAUTH_HOST_ID=monte-moria
CHATGPT_OAUTH_CALLBACK_PORT=1455
CHATGPT_OAUTH_ISSUER=https://auth.openai.com
# Optional endpoint overrides; empty means OpenID discovery/defaults.
# CHATGPT_OAUTH_AUTHORIZATION_ENDPOINT=https://auth.openai.com/api/accounts/authorize
# CHATGPT_OAUTH_TOKEN_ENDPOINT=https://auth.openai.com/api/accounts/oauth/token
# CHATGPT_OAUTH_JWKS_URI=https://auth.openai.com/.well-known/jwks.json

# ─── Security ────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Seed ────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@montemoria.com.br
SEED_ADMIN_PASSWORD="AlterarNoPrimeiroLogin123!"
