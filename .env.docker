# Monte Moria — Docker environment variables
# Copy from .env.example and adjust for Docker network Docker DNS resolves services by container name

# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/quadro_do_mane?schema=public"
POSTGRES_DB=quadro_do_mane
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── API ─────────────────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=production

# ─── JWT ─────────────────────────────────────────────────────────────────
# These should be set via secret management in production
JWT_SECRET="CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64"
JWT_REFRESH_SECRET="CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Encryption (AES-256-GCM) ─────────────────────────────────────────────
ENCRYPTION_KEY="CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32"

# ─── Frontend ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ─── S3 / Object Storage ─────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=monte-moria

# ─── Cookie / CORS ───────────────────────────────────────────────────────
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CORS_ORIGINS=https://localhost:3000,http://localhost:3000

# ─── Security ────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Seed ────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@montemoria.com.br
SEED_ADMIN_PASSWORD="AlterarNoPrimeiroLogin123!"