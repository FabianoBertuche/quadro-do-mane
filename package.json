{
  "name": "monte-moria",
  "version": "1.0.0",
  "private": true,
  "description": "Monte Moria - SaaS Task Management Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/generate-env.js",
    "start": "npm run start:prod --workspace=apps/api",
    "bootstrap": "node scripts/start-all.js",
    "dev": "node scripts/dev-all.js",
    "regen-keys": "node scripts/regenerate-secrets.js",
    "kill-port": "node scripts/kill-port.js",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:all": "npm run build:api && npm run build:web",
    "start:api": "npm run start:prod --workspace=apps/api",
    "start:web": "npm run start --workspace=apps/web",
    "db:migrate": "npm run migrate --workspace=apps/api",
    "db:seed": "npm run seed --workspace=apps/api",
    "db:generate": "npm run generate --workspace=apps/api",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "autoprefixer": "^10.4.0",
    "dompurify": "^3.4.11",
    "next": "^14.1.0",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "pm2": "^5.3.0",
    "pm2-windows-startup": "^1.0.3"
  }
}
