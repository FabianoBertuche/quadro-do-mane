# Exemplo de variáveis de ambiente para deploy em VPS
# Copie este arquivo para `.env` e preencha os valores reais.

# Traefik / Let's Encrypt
TRAEFIK_EMAIL=you@domain.com

# Hosts (domínios) - preencha com seus domínios registrados na HostGator
HOST_WEB=example.com
HOST_API=api.example.com
HOST_EDITOR=editor.example.com

# Postgres
POSTGRES_DB=quadro_do_mane
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# URL de conexão para Prisma (usado por `api`)
# Exemplo: postgresql://postgres:postgres@postgres:5432/quadro_do_mane?schema=public
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/quadro_do_mane?schema=public"

# API
NODE_ENV=production
API_PORT=3001
NEXT_PUBLIC_API_URL=https://api.example.com/api

# Secrets (NUNCA comitar valores reais)
JWT_SECRET=replace_me_with_a_strong_secret
JWT_REFRESH_SECRET=replace_me_with_a_strong_refresh_secret
ENCRYPTION_KEY=replace_me_with_a_32_byte_key

# code-server (opcional)
CODE_SERVER_PASSWORD=change_this_password
# Quadro do Mané — variáveis de ambiente
#
# IMPORTANTE: gere segredos fortes antes de subir a API em qualquer ambiente.
#   openssl rand -hex 64  -> 128 chars (use como JWT_SECRET e JWT_REFRESH_SECRET)
#   openssl rand -hex 32  -> 64 chars  (use como ENCRYPTION_KEY)
# A API falha rápido (boot aborta) se qualquer variável obrigatória estiver ausente.

# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quadro_do_mane?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────
# Segredos hex de pelo menos 32 bytes (64 chars hex). OBRIGATÓRIOS.
JWT_SECRET="CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Encryption (AES-256-GCM) ─────────────────────────────────────────────
# Chave de 32 bytes hex (64 chars). Usada para criptografar senhas de e-mail.
ENCRYPTION_KEY="CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32"

# ─── API ─────────────────────────────────────────────────────────────────
API_PORT=3001
API_PREFIX=/api

# ─── Frontend ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ─── Redis removido ─────────────────────────────────────────────────────
# A denylist de tokens JWT usa a tabela `token_denylist` no PostgreSQL
# (cleanup via pg_cron, ver DATABASE.md).

# ─── AI provider ──────────────────────────────────────────────────────────
# AI_ENABLED controla somente o fallback por API key. O OAuth global do
# ChatGPT funciona mesmo quando AI_ENABLED=false.
AI_ENABLED=false
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ─── ChatGPT plan OAuth ────────────────────────────────────────────────────
# The defaults target OpenAI. Override endpoints only for a controlled test
# double; never put access, refresh, ID tokens, or private keys in this file.
CHATGPT_OAUTH_AGENT_NAME="Monte Moria"
CHATGPT_OAUTH_HOST_ID=monte-moria
CHATGPT_OAUTH_CALLBACK_PORT=1455
CHATGPT_OAUTH_ISSUER=https://auth.openai.com
# Optional endpoint overrides. Leave empty to use OpenID discovery/defaults.
# CHATGPT_OAUTH_AUTHORIZATION_ENDPOINT=https://auth.openai.com/api/accounts/authorize
# CHATGPT_OAUTH_TOKEN_ENDPOINT=https://auth.openai.com/api/accounts/oauth/token
# CHATGPT_OAUTH_JWKS_URI=https://auth.openai.com/.well-known/jwks.json

# ─── S3 / Object Storage ─────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=monte-moria

# ─── Cookie / CORS ───────────────────────────────────────────────────────
# Em produção: COOKIE_DOMAIN=seudominio.com e COOKIE_SECURE=true
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
# Origens permitidas pelo CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000

# ─── Security ────────────────────────────────────────────────────────────
# Rounds do bcrypt (mínimo 8, recomendado 12+)
BCRYPT_ROUNDS=12

# ─── Seed ────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@quadrodomane.local
SEED_ADMIN_PASSWORD="AlterarNoPrimeiroLogin123!"
