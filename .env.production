# Quadro do Mané — .env.production (NÃO versionar)
# Preencha os placeholders antes de subir em produção

# Database: aponta para o serviço `postgres` no docker-compose
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/quadro_do_mane?schema=public"

# JWT
JWT_SECRET="d4f7a3c18b9e2f6d7c3a1b0e9f8d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1908f0e7d6c5b4a392817f6e5d4c3b2a1f0e"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="a9f8e7d6c5b4a392817f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a9f8e7d6c5b4a392817f6e5d4c3b2a1f0e9d8c7b6"
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption (AES-256-GCM)
ENCRYPTION_KEY="6a1f3e5d7c9b2a4f6e8d0c3b5a7f9e1d2c4b6a8f0e1d2c3b4a5f6e7d8c9b0a1"

# API
API_PORT=3001
API_PREFIX=/api

# Frontend
NEXT_PUBLIC_API_URL=https://api.example.com/api

# Redis (se usar)
REDIS_HOST=localhost
REDIS_PORT=6379

# S3 / Object Storage (se usar)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=quadro-do-mane

# Cookie / CORS
COOKIE_DOMAIN=example.com
COOKIE_SECURE=true
CORS_ORIGINS=https://example.com

# Security
BCRYPT_ROUNDS=12

# Seed (ajuste conforme necessário)
SEED_ADMIN_EMAIL=admin@exemplo.com
SEED_ADMIN_PASSWORD="AlterarNoPrimeiroLogin123!"

# code-server (edito remoto)
CODE_SERVER_PASSWORD=alterar-senha-editor

# Notas:
# - Substitua `example.com` e `api.example.com` pelos domínios reais.
# - Preencha `S3_*` se utilizar storage de objetos.
# - Mantenha este arquivo fora do controle de versão (ver .gitignore).
