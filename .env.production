# Monte Moria — Production Environment Variables
# ============================================================
# BEFORE DEPLOYING: Change ALL passwords and secrets below!
#     Generate new secrets with: node scripts/regenerate-secrets.js
# ============================================================

# Database
POSTGRES_DB=quadro_do_mane
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeThisPassword123!
DATABASE_URL="postgresql://postgres:ChangeThisPassword123!@postgres:5432/quadro_do_mane?schema=public"

# JWT
JWT_SECRET="CHANGE_ME_generate_with_node_scripts/regenerate-secrets.js"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="CHANGE_ME_generate_with_node_scripts/regenerate-secrets.js"
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption (AES-256-GCM)
ENCRYPTION_KEY="CHANGE_ME_generate_with_node_scripts/regenerate-secrets.js"

# API
API_PORT=3001
API_PREFIX=/api

# Frontend
# When using Nginx reverse proxy, use relative URL
NEXT_PUBLIC_API_URL=/api

# Cookie / CORS
# Without domain: leave empty (works with IP)
# With domain: set to your domain (e.g., montemoria.com)
COOKIE_DOMAIN=
COOKIE_SECURE=false
CORS_ORIGINS=*

# Seed Admin
SEED_ADMIN_EMAIL=admin@montemoria.com.br
SEED_ADMIN_PASSWORD="AlterarNoPrimeiroLogin123!"
