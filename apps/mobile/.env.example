# URL pública da API (NestJS). O app no celular NÃO consegue acessar
# localhost da sua máquina — use o domínio público ou o IP da rede local.
#
# Produção:   EXPO_PUBLIC_API_URL=https://seu-dominio.com/api
# Emulador Android: EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api
# Dispositivo físico (mesma rede): EXPO_PUBLIC_API_URL=http://192.168.X.X:3001/api
EXPO_PUBLIC_API_URL=https://seu-dominio.com/api

# ⚠️ PUSH NOTIFICATIONS (Android) — NECESSÁRIO para push funcionar em standalone:
#
# 1. Crie um projeto no Firebase Console (https://console.firebase.google.com)
#    e adicione um app Android com o package: com.quadrodomane.app
# 2. Baixe o arquivo `google-services.json` e coloque em:
#    apps/mobile/google-services.json
# 3. Confirme que o package no Firebase é exatamente: com.quadrodomane.app
#
# Sem este arquivo, o app não gera token de push válido no Android standalone.
# O app.config.js já referencia `./google-services.json` (ver campo android.googleServicesFile).
