# URL pública da API (NestJS). O app no celular NÃO consegue acessar
# localhost da sua máquina — use o domínio público ou o IP da rede local.
#
# Produção:   EXPO_PUBLIC_API_URL=https://seu-dominio.com/api
# Emulador Android: EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api
# Dispositivo físico (mesma rede): EXPO_PUBLIC_API_URL=http://192.168.X.X:3001/api
EXPO_PUBLIC_API_URL=https://seu-dominio.com/api
